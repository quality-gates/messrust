#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 5 ]]; then
  echo "Usage: $0 VERSION ARCH EXECUTABLE OUTPUT_DIRECTORY SOURCE_DATE_EPOCH" >&2
  exit 1
fi

version="$1"
arch="$2"
executable="$3"
output_directory="$4"
source_date_epoch="$5"

if [[ ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "VERSION must have the MAJOR.MINOR.PATCH format." >&2
  exit 1
fi
case "$arch" in
  arm64 | amd64) ;;
  *)
    echo "ARCH must be arm64 or amd64." >&2
    exit 1
    ;;
esac
if [[ ! -f "$executable" || ! -x "$executable" ]]; then
  echo "EXECUTABLE must be an executable file." >&2
  exit 1
fi
if [[ ! "$source_date_epoch" =~ ^[0-9]+$ ]]; then
  echo "SOURCE_DATE_EPOCH must be a nonnegative integer." >&2
  exit 1
fi

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -f "$repository_root/LICENSE" ]]; then
  echo "The repository LICENSE file does not exist." >&2
  exit 1
fi

mkdir -p "$output_directory"
output_directory="$(cd "$output_directory" && pwd)"
package_directory="$(mktemp -d "${TMPDIR:-/tmp}/messrust-release.XXXXXX")"
trap 'rm -rf "$package_directory"' EXIT

install -m 0755 "$executable" "$package_directory/messrust"
install -m 0644 "$repository_root/LICENSE" "$package_directory/LICENSE"
archive="messrust_${version}_darwin_${arch}.tar.gz"
archive_path="$output_directory/$archive"
python3 - "$package_directory" "$archive_path" "$source_date_epoch" <<'PY'
import gzip
from pathlib import Path
import sys
import tarfile

package = Path(sys.argv[1])
archive = Path(sys.argv[2])
epoch = int(sys.argv[3])
with archive.open("wb") as raw:
    with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=epoch) as compressed:
        with tarfile.open(fileobj=compressed, mode="w", format=tarfile.USTAR_FORMAT) as output:
            for name, mode in (("LICENSE", 0o644), ("messrust", 0o755)):
                source = package / name
                info = output.gettarinfo(str(source), arcname=name)
                info.uid = 0
                info.gid = 0
                info.uname = ""
                info.gname = ""
                info.mtime = epoch
                info.mode = mode
                with source.open("rb") as contents:
                    output.addfile(info, contents)
PY
printf '%s\n' "$archive_path"
